# whatsapp-business-gateway Evolution endpoints. Server-side only: the
# inbox's /api routes call it, forwarding the user's access_token cookie
# and the ?instance= the admin iframe was opened with.
# Local dev: gateway on :3001. Docker: http://whatsapp-gateway:3001/api/v1/evolution-api
EVOLUTION_API_URL=http://localhost:3001/api/v1/evolution-api

# Path prefix the app is served under. Empty locally; /inbox in production
# (app.whatidea.io/inbox?instance=...). Must be set for BOTH `next build`
# (client assets/links) and `next start` (server routes) — next.config.ts is
# evaluated again at startup.
NEXT_PUBLIC_BASE_PATH=
